# Ключ OpenRouter (https://openrouter.ai/keys). Без ключа приложение работает в демо-режиме.
OPENROUTER_API_KEY=

# Версия пайплайна по умолчанию: v1 (бейзлайн) | v2 (сжатие контекста + сверка) | v3 (v2 на лёгкой модели)
AGENT_VERSION=v2

# Модели версий (любые модели OpenRouter с поддержкой tool calling)
MODEL_V1=openai/gpt-4.1-mini
MODEL_V2=openai/gpt-4.1-mini
MODEL_V3=google/gemini-3.1-flash-lite

# 1 — не ходить во внешние API (тесты/демо без сети)
OFFLINE_MODE=0
