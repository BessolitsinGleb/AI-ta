# Ключ OpenRouter (https://openrouter.ai/keys). Без ключа приложение работает в демо-режиме.
OPENROUTER_API_KEY=

# Версия пайплайна по умолчанию: v1 (бейзлайн) | v2 (сжатие контекста + сверка) | v3 (v2 на DeepSeek, финальная)
AGENT_VERSION=v3

# Модели версий (любые модели OpenRouter с поддержкой tool calling)
MODEL_V1=minimax/minimax-m3.1-flash:free
MODEL_V2=minimax/minimax-m3.1-flash:free
MODEL_V3=deepseek/deepseek-v4.1-flash

# Необязательно: отдельный ключ на версию (например, для эвала на разных аккаунтах)
# OPENROUTER_API_KEY_V1=
# OPENROUTER_API_KEY_V2=
# OPENROUTER_API_KEY_V3=

# 1 — не ходить во внешние API (тесты/демо без сети)
OFFLINE_MODE=0

# --- Аккаунты ---
# Секрет подписи JWT: длинная случайная строка (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
# Адрес сайта для ссылок в письмах
PUBLIC_URL=http://localhost:8000
# 1 — cookie только по HTTPS (включите на проде)
COOKIE_SECURE=0
# База данных (по умолчанию SQLite в data/amba.db)
# DATABASE_URL=sqlite:///data/amba.db

# --- Почта: Gmail SMTP с паролем приложения (Google → Безопасность → Пароли приложений) ---
# Пока SMTP_PASSWORD пуст, письма пишутся в лог сервера, а не отправляются.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Амба <your-address@gmail.com>
