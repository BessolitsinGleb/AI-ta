# Ключ OpenRouter (https://openrouter.ai/keys). Без ключа приложение работает в демо-режиме.
OPENROUTER_API_KEY=

# Версия пайплайна по умолчанию: v1 (бейзлайн) | v2 (сжатие контекста + сверка) | v3 (v2 на DeepSeek, финальная)
AGENT_VERSION=v3

# Модели версий (любые модели OpenRouter с поддержкой tool calling)
MODEL_V1=minimax/minimax-m3.1-flash:free
MODEL_V2=minimax/minimax-m3.1-flash:free
MODEL_V3=deepseek/deepseek-v4.1-flash

# Необязательно: отдельный ключ на версию (например, для эвала на разных аккаунтах)
# OPENROUTER_API_KEY_V1=
# OPENROUTER_API_KEY_V2=
# OPENROUTER_API_KEY_V3=

# 1 — не ходить во внешние API (тесты/демо без сети)
OFFLINE_MODE=0
